{
  "name": "excel-claude-ai-addin",
  "version": "1.0.0",
  "description": "Claude AI add-in for Excel: chat agent that reads, writes, formats, charts, pivots and analyzes your workbook, plus =CLAUDE.* custom functions.",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "start": "office-addin-debugging start manifest.xml desktop",
    "stop": "office-addin-debugging stop manifest.xml desktop",
    "validate": "office-addin-manifest validate manifest.xml",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0"
  },
  "devDependencies": {
    "@types/custom-functions-runtime": "^1.6.13",
    "@types/office-js": "^1.0.611",
    "copy-webpack-plugin": "^12.0.2",
    "custom-functions-metadata-plugin": "^3.0.1",
    "html-webpack-plugin": "^5.6.3",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-manifest": "^3.0.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.6.3",
    "webpack": "^5.97.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0"
  }
}
